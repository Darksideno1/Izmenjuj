@model AdminDashboardViewModel
@{
    ViewData["Title"] = "ADMIN";
}

<section class="page-head admin-page-head">
    <div>
        <div class="page-kicker">ADMINISTRACIJA</div>
        <h1>Nadzorna plošča</h1>
        <p>Upravljanje kataloga, uporabnikov, prijav in administrativnih orodij.</p>
    </div>
</section>

<section class="admin-stat-grid">
    <a asp-action="Users"><small>Uporabniki</small><strong>@Model.Users</strong><span>upravljanje računov →</span></a>
    <a asp-action="Collections"><small>Zbirke</small><strong>@Model.Collections</strong><span>katalog in predmeti →</span></a>
    <a asp-action="Collections"><small>Predmeti</small><strong>@Model.Items</strong><span>urejanje vsebine →</span></a>
    <a asp-action="Trades"><small>Aktivne menjave</small><strong>@Model.ActiveTrades</strong><span>read-only pregled →</span></a>
    <a asp-action="Reports" asp-route-status="Open"><small>Odprte prijave</small><strong>@Model.OpenReports</strong><span>moderiranje →</span></a>
    <a asp-action="Users"><small>Suspendirani</small><strong>@Model.SuspendedUsers</strong><span>pregled računov →</span></a>
</section>

<section class="panel admin-tools-panel">
    <header><h2>Administrativna orodja</h2></header>
    <div class="admin-tool-grid">
        <a asp-action="Collections"><b>▣ Zbirke in predmeti</b><span>Objava, urejanje, množični vnos in združevanje dvojnikov.</span></a>
        <a asp-action="Users"><b>◎ Uporabniki</b><span>Iskanje uporabnikov ter suspendiranje in ponovna aktivacija računov.</span></a>
        <a asp-action="Reports"><b>⚑ Prijave</b><span>Pregled prijav, povezava na menjavo ter razrešitev ali zavrnitev.</span></a>
        <a asp-action="Trades"><b>⇄ Menjave</b><span>Read-only pregled predmetov, dogodkov in zasebnih sporočil za moderiranje.</span></a>
    </div>
</section>

@model Collection
@{
    ViewData["Title"] = "Izbriši zbirko";
}
<section class="auth-wrap">
    <div class="auth-card danger-card">
        <div class="page-kicker">BRISANJE</div>
        <h1>Izbrišem »@Model.Title«?</h1>
        <p class="muted">Izbrisana bo zbirka skupaj z njenimi dodatnimi slikami in podatki. Tega dejanja ni mogoče razveljaviti.</p>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
            <a class="secondary button" asp-action="Details" asp-route-id="@Model.Id">Nazaj</a>
            <button class="danger-button" type="submit">Da, izbriši zbirko</button>
        </form>
    </div>
</section>

@{
    ViewData["Title"] = "Domov";
}
<section class="hero">
    <div><span class="eyebrow">DOBRODOŠEL NA</span><h1>izmenjuj.si</h1><p>Zbiraj. Menjaj. Dopolni zbirko.</p><div class="hero-actions"><a class="primary" asp-controller="Collections" asp-action="Index">Razišči zbirke →</a>@if (User.Identity?.IsAuthenticated == true) { <a class="secondary" asp-controller="Matches" asp-action="Index">Poišči ujemanja</a> } else { <a class="secondary" asp-controller="Account" asp-action="Register">Pridruži se</a> }</div></div>
    <div class="card-fan"><div class="sample-card sport">Šport</div><div class="sample-card nature">Živali</div><div class="sample-card fantasy">Fantazija</div></div>
</section>

<section class="stats">
    <article><span class="stat-icon blue">▤</span><div><small>Zbirke</small><strong>F1</strong><em>aktivno</em></div></article>
    <article><span class="stat-icon red">□</span><div><small>Manjkajoče</small><strong>F2</strong><em>aktivno</em></div></article>
    <article><span class="stat-icon green">⇄</span><div><small>Za menjavo</small><strong>F2</strong><em>aktivno</em></div></article>
    <article><span class="stat-icon violet">◇</span><div><small>Ujemanja</small><strong>F3</strong><em>aktivno</em></div></article>
</section>

<div class="dashboard-grid">
<section class="panel" id="albums">
    <header><h2>Kaj lahko zbiraš</h2><a asp-controller="Collections" asp-action="Index">Prikaži zbirke →</a></header>
    <div class="album-grid">
        <article class="album-card"><div class="cover cover-sport"><b>1–999</b><span>SLIČICE</span></div><h3>Oštevilčeni albumi</h3><p>Klasične sličice z uradnimi številkami in podatki albuma.</p></article>
        <article class="album-card"><div class="cover cover-animals"><b>📷</b><span>FIGURICE</span></div><h3>Zbirke brez številk</h3><p>Vizualna identifikacija z nazivom, interno oznako in več slikami.</p></article>
        <article class="album-card"><div class="cover cover-fantasy"><b>VAR</b><span>KARTE IN DRUGO</span></div><h3>Različice in posebnosti</h3><p>Podlaga je pripravljena tudi za variante posameznih predmetov.</p></article>
    </div>
</section>

<section class="panel matches" id="matches">
    <header><h2>Pametno ujemanje</h2>@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Matches" asp-action="Index">Odpri ujemanja →</a> }</header>
    <article class="match"><div class="avatar">1</div><div><h3>Obojestranska korist</h3><strong>Aktivno</strong><p>Ti imaš, kar drugi išče, in obratno.</p></div></article>
    <article class="match"><div class="avatar">2</div><div><h3>Filtri menjave</h3><strong>Aktivno</strong><p>Zbirka, kraj, pošta ali osebna menjava.</p></div></article>
    <article class="match"><div class="avatar">3</div><div><h3>Uravnotežen predlog</h3><strong>Aktivno</strong><p>Najprej se prikažejo najbolj uravnotežene menjave.</p></div></article>
</section>
</div>

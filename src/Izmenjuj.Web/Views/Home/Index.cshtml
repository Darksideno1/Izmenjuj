@{
    ViewData["Title"] = "Domov";
}
<section class="home-welcome">
    <div class="welcome-main">
        <span class="eyebrow">ZBIRATELJI NA ENEM MESTU</span>
        <h1>Zbiraj. Menjaj. Dopolni zbirko.</h1>
        <p>Izmenjuj.si poveže tvoje manjkajoče predmete z viški drugih zbirateljev – ne glede na to, ali zbiraš sličice, karte, figurice ali kaj drugega.</p>
        <div class="hero-actions">
            <a class="primary button" asp-controller="Collections" asp-action="Index">Razišči zbirke</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="secondary button" asp-controller="Matches" asp-action="Index">Poišči ujemanja</a>
            }
            else
            {
                <a class="secondary button" asp-controller="Account" asp-action="Register">Ustvari račun</a>
            }
        </div>
    </div>
    <div class="welcome-visual" aria-hidden="true">
        <div class="visual-stack">
            <div class="visual-card one"><div></div><b>Sličice</b><small>številke in albumi</small></div>
            <div class="visual-card two"><div></div><b>Karte</b><small>variante in serije</small></div>
            <div class="visual-card three"><div></div><b>Figurice</b><small>vizualna identifikacija</small></div>
            <span class="visual-exchange">↔</span>
        </div>
    </div>
</section>

<section class="home-steps" aria-label="Kako deluje Izmenjuj.si">
    <article class="home-step"><span>1</span><div><h3>Uredi svojo zbirko</h3><p>Označi, kaj imaš, kaj iščeš in koliko primerkov lahko zamenjaš.</p></div></article>
    <article class="home-step"><span>2</span><div><h3>Poišči pravo ujemanje</h3><p>Sistem poišče zbiratelje, kjer imata oba nekaj, kar potrebuje drugi.</p></div></article>
    <article class="home-step"><span>3</span><div><h3>Dogovori menjavo</h3><p>Pošlji konkreten predlog, uskladi podrobnosti in potrdi zaključen posel.</p></div></article>
</section>

<div class="home-grid">
    <section class="panel">
        <header><h2>Za različne vrste zbirk</h2><a asp-controller="Collections" asp-action="Index">Poglej vse zbirke</a></header>
        <div class="collection-type-grid">
            <article class="collection-type-card"><div class="type-icon">001</div><h3>Oštevilčeni albumi</h3><p>Hiter, kompakten pregled številk brez obveznega prikaza slike vsake sličice.</p></article>
            <article class="collection-type-card"><div class="type-icon">VAR</div><h3>Karte in različice</h3><p>Uradna oznaka, interna koda in varianta ostanejo jasno vidne pri posameznem predmetu.</p></article>
            <article class="collection-type-card"><div class="type-icon">IMG</div><h3>Figurice in posebnosti</h3><p>Kjer je videz pomemben, lahko zbirka uporablja glavno fotografijo in dodatno galerijo.</p></article>
        </div>
    </section>

    <section class="panel">
        <header><h2>Menjava brez ugibanja</h2>@if (User.Identity?.IsAuthenticated == true) { <a asp-controller="Trades" asp-action="Index">Moje menjave</a> }</header>
        <div class="home-status-list">
            <div class="home-status"><span class="home-status-dot"></span><div><strong>Točno določeni predmeti</strong><p>Pri predlogu vidiš kodo, naziv, zbirko, različico in količino.</p></div></div>
            <div class="home-status"><span class="home-status-dot"></span><div><strong>Zaseben pogovor</strong><p>Sporočila so vezana na posamezno menjavo in niso javna.</p></div></div>
            <div class="home-status"><span class="home-status-dot"></span><div><strong>Dvostranski zaključek</strong><p>Evidenca se spremeni šele, ko zaključek potrdita oba udeleženca.</p></div></div>
        </div>
    </section>
</div>

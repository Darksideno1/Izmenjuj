@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Pozabljeno geslo";
}
<section class="auth-wrap">
    <div class="auth-card">
        <div class="page-kicker">OBNOVITEV DOSTOPA</div>
        <h1>Pozabljeno geslo</h1>
        <p class="muted">Vnesi e-pošto računa. Če račun obstaja, bomo poslali povezavo za novo geslo.</p>
        <form asp-action="ForgotPassword" method="post" class="form-grid single">
            <div asp-validation-summary="ModelOnly" class="validation"></div>
            <label><span asp-for="Email"></span><input asp-for="Email" autocomplete="email" /><small asp-validation-for="Email"></small></label>
            <button class="primary button" type="submit">Pošlji povezavo</button>
        </form>
        <p class="auth-footer"><a asp-action="Login">Nazaj na prijavo</a></p>
    </div>
</section>

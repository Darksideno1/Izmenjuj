@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f9fc" />
    <title>@ViewData["Title"] - Izmenjuj.si</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase3.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase4.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase5.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ui-refresh.css" asp-append-version="true" />
</head>
<body>
<svg class="svg-sprite" aria-hidden="true">
    <symbol id="i-home" viewBox="0 0 24 24"><path d="M3 10.8 12 3l9 7.8v9.7a.5.5 0 0 1-.5.5H15v-7H9v7H3.5a.5.5 0 0 1-.5-.5z"/></symbol>
    <symbol id="i-collections" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h10M7 16h6"/></symbol>
    <symbol id="i-match" viewBox="0 0 24 24"><path d="M4 7h13l-3-3M20 17H7l3 3M17 7l-3 3M7 17l3-3"/></symbol>
    <symbol id="i-trade" viewBox="0 0 24 24"><path d="M5 5h6v6H5zM13 13h6v6h-6zM14 6h5v5M10 18H5v-5"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></symbol>
    <symbol id="i-admin" viewBox="0 0 24 24"><path d="M12 3 4 6v5c0 5.2 3.2 8.7 8 10 4.8-1.3 8-4.8 8-10V6z"/><path d="m9 12 2 2 4-4"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
    <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 4H5v16h5M14 8l4 4-4 4M8 12h10"/></symbol>
</svg>

<header class="app-header">
    <div class="header-brand-area">
        <button class="mobile-menu-toggle" id="navToggle" type="button" aria-label="Odpri navigacijo" aria-controls="sideNav" aria-expanded="false">
            <svg><use href="#i-menu"></use></svg>
        </button>
        <a class="brand-lockup" asp-controller="Home" asp-action="Index" aria-label="Izmenjuj.si domov">
            <span class="brand-mark" aria-hidden="true"><i></i><b></b><em>↔</em></span>
            <span class="brand-copy"><strong>izmenjuj.si</strong><small>Zbiraj · menjaj · dopolni</small></span>
        </a>
    </div>

    <form class="global-search" asp-controller="Collections" asp-action="Index" method="get">
        <svg><use href="#i-search"></use></svg>
        <input name="q" aria-label="Iskanje" placeholder="Išči zbirke in predmete ..." />
    </form>

    <nav class="header-nav" aria-label="Glavna navigacija">
        <a class="@(controller == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index">Domov</a>
        <a class="@(controller is "Collections" or "Items" or "Inventory" ? "active" : null)" asp-controller="Collections" asp-action="Index">Zbirke</a>
        @if (authenticated)
        {
            <a class="@(controller == "Matches" ? "active" : null)" asp-controller="Matches" asp-action="Index">Ujemanja</a>
            <a class="@(controller == "Trades" ? "active" : null)" asp-controller="Trades" asp-action="Index">Menjave</a>
        }
    </nav>

    <div class="header-account">
        @if (authenticated)
        {
            @if (User.IsInRole("Admin"))
            {
                <a class="admin-chip" asp-controller="Admin" asp-action="Index">ADMIN</a>
            }
            <a class="account-link" asp-controller="Account" asp-action="Profile" title="Profil">
                <span class="account-avatar"><svg><use href="#i-user"></use></svg></span>
                <span>Moj profil</span>
            </a>
        }
        else
        {
            <a class="signin-link" asp-controller="Account" asp-action="Login">Prijava</a>
            <a class="primary compact" asp-controller="Account" asp-action="Register">Registracija</a>
        }
    </div>
</header>

<div class="nav-backdrop" id="navBackdrop"></div>
<div class="app-shell">
    <aside class="app-sidebar" id="sideNav">
        <div class="sidebar-mobile-head">
            <span>Navigacija</span>
            <button id="navClose" type="button" aria-label="Zapri navigacijo"><svg><use href="#i-close"></use></svg></button>
        </div>
        <form class="mobile-search" asp-controller="Collections" asp-action="Index" method="get">
            <svg><use href="#i-search"></use></svg><input name="q" placeholder="Išči ..." />
        </form>
        <div class="sidebar-label">PREGLED</div>
        <nav class="side-nav" aria-label="Stranska navigacija">
            <a class="@(controller == "Home" ? "active" : null)" asp-controller="Home" asp-action="Index"><svg><use href="#i-home"></use></svg><span>Domov</span></a>
            <a class="@(controller is "Collections" or "Items" or "Inventory" ? "active" : null)" asp-controller="Collections" asp-action="Index"><svg><use href="#i-collections"></use></svg><span>Zbirke</span></a>
            @if (authenticated)
            {
                <a class="@(controller == "Matches" ? "active" : null)" asp-controller="Matches" asp-action="Index"><svg><use href="#i-match"></use></svg><span>Ujemanja</span></a>
                <a class="@(controller == "Trades" ? "active" : null)" asp-controller="Trades" asp-action="Index"><svg><use href="#i-trade"></use></svg><span>Menjave in sporočila</span></a>
                <a class="@(controller == "Account" ? "active" : null)" asp-controller="Account" asp-action="Profile"><svg><use href="#i-user"></use></svg><span>Profil</span></a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="@(controller == "Admin" ? "active" : null)" asp-controller="Admin" asp-action="Index"><svg><use href="#i-admin"></use></svg><span>Administracija</span></a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Matches"><svg><use href="#i-match"></use></svg><span>Poišči ujemanja</span></a>
            }
        </nav>

        <div class="sidebar-spacer"></div>
        @if (authenticated)
        {
            <a class="sidebar-create" asp-controller="Collections" asp-action="Create"><svg><use href="#i-plus"></use></svg><span>Dodaj zbirko</span></a>
            <form class="sidebar-logout" asp-controller="Account" asp-action="Logout" method="post"><button type="submit"><svg><use href="#i-logout"></use></svg><span>Odjava</span></button></form>
        }
        else
        {
            <div class="sidebar-join"><strong>Začni svojo zbirko</strong><p>Ustvari profil in poišči zbiratelje za menjavo.</p><a class="primary button" asp-controller="Account" asp-action="Register">Pridruži se</a></div>
        }
    </aside>

    <main class="app-content">@RenderBody()</main>
</div>

<script>
(() => {
    const body = document.body;
    const open = document.getElementById('navToggle');
    const close = document.getElementById('navClose');
    const backdrop = document.getElementById('navBackdrop');
    const setOpen = value => {
        body.classList.toggle('nav-open', value);
        open?.setAttribute('aria-expanded', value ? 'true' : 'false');
    };
    open?.addEventListener('click', () => setOpen(true));
    close?.addEventListener('click', () => setOpen(false));
    backdrop?.addEventListener('click', () => setOpen(false));
    document.querySelectorAll('#sideNav a').forEach(x => x.addEventListener('click', () => setOpen(false)));
})();
</script>
</body>
</html>

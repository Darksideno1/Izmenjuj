<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Izmenjuj.si</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase3.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/phase4.css" asp-append-version="true" />
</head>
<body>
<header class="topbar">
    <a class="brand" asp-controller="Home" asp-action="Index">↔ <span>izmenjuj.si</span></a>
    <form class="search" asp-controller="Collections" asp-action="Index" method="get"><span>⌕</span><input name="q" aria-label="Iskanje" placeholder="Išči albume, predmete, uporabnike ..." /></form>
    <nav class="topnav">
        <a asp-controller="Home" asp-action="Index">Domov</a>
        <a asp-controller="Collections" asp-action="Index">Albumi</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Matches" asp-action="Index">Ujemanja</a>
            <a asp-controller="Trades" asp-action="Index">Menjave</a>
            <a asp-controller="Account" asp-action="Profile">Profil</a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Odjava</button></form>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Matches">Ujemanja</a>
            <a asp-controller="Account" asp-action="Login">Prijava</a>
            <a class="nav-register" asp-controller="Account" asp-action="Register">Registracija</a>
        }
    </nav>
</header>
<div class="shell">
    <aside class="sidebar">
        <a asp-controller="Home" asp-action="Index">⌂ <span>Domov</span></a>
        <a asp-controller="Collections" asp-action="Index">▣ <span>Zbirke</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Matches" asp-action="Index">⇄ <span>Ujemanja</span></a>
            <a asp-controller="Trades" asp-action="Index">◆ <span>Menjave</span></a>
            <a asp-controller="Trades" asp-action="Index">◌ <span>Sporočila</span></a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Matches">⇄ <span>Ujemanja</span></a>
        }
        <a href="#">◎ <span>Skupnost</span></a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Account" asp-action="Profile">⚙ <span>Profil</span></a>
        }
        <div class="sidebar-spacer"></div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="add-button" asp-controller="Collections" asp-action="Create">＋ <span>Dodaj zbirko</span></a>
        }
        else
        {
            <a class="add-button" asp-controller="Account" asp-action="Register">＋ <span>Pridruži se</span></a>
        }
    </aside>
    <main class="content">@RenderBody()</main>
</div>
</body>
</html>
